{# Runtime journey picker — included by the explorer nav so every
   explorer page shows it.

   Submit is an explicit button (not auto-submit on change). An
   inline <script> would land on every explorer page and break
   index.test.js's "exactly one inline script per page" CSP
   assertion. The extra click is the acceptable trade. #}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}

<form method="post" action="/explorer/journey" class="govuk-!-margin-bottom-4">
  <div class="govuk-form-group govuk-!-margin-bottom-2">
    {{ govukSelect({
      id: "journey-picker",
      name: "journey",
      label: { text: "Journey", classes: "govuk-label--s" },
      items: journeyOptions
    }) }}
  </div>
  {{ govukButton({
    text: "Switch",
    classes: "govuk-button--secondary govuk-!-margin-bottom-2"
  }) }}
</form>
