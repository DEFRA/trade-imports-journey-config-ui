{# Explorer navigation — shared across all explorer pages #}
<nav class="govuk-!-margin-bottom-6" aria-label="Explorer pages">
  {% if journeyKey %}
    <p class="govuk-body-s govuk-!-margin-bottom-2"><strong>Journey:</strong> {{ journeyKey }}</p>
  {% endif %}
  <ul class="app-explorer-nav">
    <li><a class="govuk-link{% if currentPage == 'journey' %} govuk-link--no-underline govuk-!-font-weight-bold{% endif %}" href="/explorer">Journey Configuration</a></li>
    <li><a class="govuk-link{% if currentPage == 'tasklist' %} govuk-link--no-underline govuk-!-font-weight-bold{% endif %}" href="/explorer/tasklist">Task List</a></li>
    <li><a class="govuk-link{% if currentPage == 'debug' %} govuk-link--no-underline govuk-!-font-weight-bold{% endif %}" href="/explorer/debug">Evaluation Debugger</a></li>
    {% if showCommodityConfig %}
      <li><a class="govuk-link{% if currentPage == 'commodity-config' %} govuk-link--no-underline govuk-!-font-weight-bold{% endif %}" href="/explorer/commodity-config">Commodity Config</a></li>
    {% endif %}
  </ul>
</nav>
