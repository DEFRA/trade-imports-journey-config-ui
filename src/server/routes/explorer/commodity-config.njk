{% extends 'layouts/page.njk' %}

{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "dimension-block/macro.njk" import dimensionBlock %}
{% from "detail-block/macro.njk" import detailBlock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Obligation Evaluation Engine"
  }) }}

  {% include "partials/explorer-nav.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {# Commodity selection form #}
      <form method="get" action="/explorer/commodity-config" id="commodity-form" class="govuk-!-margin-bottom-8">
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{ govukSelect({
              id: "commodity",
              name: "commodity",
              label: {
                text: "Select commodity"
              },
              items: commodityOptions
            }) }}
          </div>
        </div>

        {{ govukButton({
          text: "View configuration"
        }) }}
      </form>

      {# Configuration display (only if commodity selected) #}
      {% if selectedCommodity %}

        {# Journey-neutral commodity summary #}
        <div class="app-explorer-section">
          <h2 class="govuk-heading-l">Commodity Summary</h2>
          <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Commodity code</dt>
              <dd class="govuk-summary-list__value">{{ commodityID }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Species / EPPO</dt>
              <dd class="govuk-summary-list__value">{{ speciesName }}</dd>
            </div>
          </dl>
        </div>

        {# Variance-annotated dimensions #}
        {% for d in dimensionViews %}
          {{ dimensionBlock(d, totalCommodities) }}
        {% endfor %}

        {# Per-commodity details (as-is, no variance) #}
        {% for dt in detailViews %}
          {{ detailBlock(dt) }}
        {% endfor %}

      {% endif %}

    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  {# Auto-submit form when commodity selected #}
  <script>
    document.getElementById('commodity-form').addEventListener('change', function() {
      var commodity = document.getElementById('commodity').value
      if (commodity) {
        this.submit()
      }
    })
  </script>
{% endblock %}
