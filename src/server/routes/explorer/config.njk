{% extends 'layouts/page.njk' %}

{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Obligation Evaluation Engine"
  }) }}

  {% include "partials/explorer-nav.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {# Selection form #}
      <form method="get" action="/explorer/config" id="config-form" class="govuk-!-margin-bottom-8">
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{ govukSelect({
              id: "purposeGroup",
              name: "purposeGroup",
              label: {
                text: "Purpose group"
              },
              items: purposeSelectItems
            }) }}
          </div>
          <div class="govuk-grid-column-one-half">
            {{ govukSelect({
              id: "commodity",
              name: "commodity",
              label: {
                text: "Commodity"
              },
              items: commoditySelectItems
            }) }}
          </div>
        </div>

        {{ govukButton({
          text: "View configuration"
        }) }}
      </form>

      {# Error message #}
      {% if error %}
        <div class="govuk-error-summary" role="alert">
          <h2 class="govuk-error-summary__title">There is a problem</h2>
          <div class="govuk-error-summary__body">
            <p class="govuk-body">{{ error }}</p>
          </div>
        </div>
      {% endif %}

      {# Journey structure (only if evaluated) #}
      {% if sections %}
        <h2 class="govuk-heading-l govuk-!-margin-top-8">Journey Structure</h2>

        {% if summary %}
          <dl class="govuk-summary-list govuk-!-margin-bottom-6">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Total obligations</dt>
              <dd class="govuk-summary-list__value">{{ summary.total }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Satisfied</dt>
              <dd class="govuk-summary-list__value">{{ summary.satisfied }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Unsatisfied</dt>
              <dd class="govuk-summary-list__value">{{ summary.unsatisfied }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Submittable</dt>
              <dd class="govuk-summary-list__value">
                {% if summary.submittable %}
                  {{ govukTag({ text: "Yes", classes: "govuk-tag--green" }) }}
                {% else %}
                  {{ govukTag({ text: "No", classes: "govuk-tag--red" }) }}
                {% endif %}
              </dd>
            </div>
          </dl>
        {% endif %}

        {% for section in sections %}
          <h3 class="govuk-heading-m govuk-!-margin-top-6">{{ section.sectionName }}</h3>

          {% for screen in section.screens %}
            <div class="govuk-!-margin-bottom-6" {% if screen.status == 'notApplicable' %}class="app-explorer-dimmed"{% endif %}>
              <h4 class="govuk-heading-s govuk-!-margin-bottom-2">
                {{ screen.screenName }}
                {% if screen.status == 'complete' %}
                  {{ govukTag({ text: "Complete", classes: "govuk-tag--green" }) }}
                {% elif screen.status == 'incomplete' %}
                  {{ govukTag({ text: "Incomplete", classes: "govuk-tag--blue" }) }}
                {% elif screen.status == 'cannotStartYet' %}
                  {{ govukTag({ text: "Cannot start yet", classes: "govuk-tag--grey" }) }}
                {% elif screen.status == 'notApplicable' %}
                  {{ govukTag({ text: "Not applicable", classes: "govuk-tag--grey" }) }}
                {% endif %}
              </h4>

              {% if screen.fields and screen.fields.length > 0 %}
                {{ govukTable({
                  head: [
                    { text: "Field" },
                    { text: "Type" },
                    { text: "Obligation" },
                    { text: "Status" }
                  ],
                  rows: screen.fields | fieldRows
                }) }}
              {% else %}
                <p class="govuk-body govuk-!-font-size-16">No fields</p>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      {% endif %}

    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  {# Auto-submit form when both dropdowns have values #}
  <script>
    document.getElementById('config-form').addEventListener('change', function() {
      var purpose = document.getElementById('purposeGroup').value
      var commodity = document.getElementById('commodity').value
      if (purpose && commodity) {
        this.submit()
      }
    })
  </script>
{% endblock %}
