        },
        {
          "id": "02-06",
          "screenName": "For test and trial",
          "fields": [
            {
              "fieldName": "for-test-and-trial",
              "fieldType": "radio",
              "label": "Are these goods for test and trial?",
              "obligationRef": "test-and-trial"
