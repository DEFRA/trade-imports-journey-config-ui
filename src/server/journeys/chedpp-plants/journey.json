              "fieldName": "commodity-input-method",
              "fieldType": "radio",
              "label": "Do you know the commodity code?"
            },
            {
              "fieldName": "selected-commodity",
              "fieldType": "search",
              "label": "Search commodities by code or keywords",
              "obligationRef": "commodity-selection"
            }
