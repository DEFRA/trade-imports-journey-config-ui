{
  "journey": "Proposed - CHEDPP Plants - Notification Only",
  "version": "2.0",
  "description": "Presentation layer only. Defines screens, fields, field types, labels, and visibility conditions. Schema paths, commodity conditions, and required/optional status live on obligations. Screen visibility is emergent: if all fields' obligations are inactive, the runtime skips the screen.",
  "sections": [
    {
      "id": "01",
      "name": "About",
      "screens": [
        {
          "id": "01-01",
          "screenName": "What are you importing",
          "fields": [
            {
              "fieldName": "cert-type",
              "fieldType": "radio",
              "label": "What are you importing?",
              "obligationRef": "notification-type"
            }
          ]
        },
        {
          "id": "01-02",
          "screenName": "Origin of the import",
          "fields": [
            {
              "fieldName": "country-of-origin",
              "fieldType": "select",
              "label": "Country of origin",
              "obligationRef": "consignment-origin"
            },
            {
              "fieldName": "consigned-country",
              "fieldType": "select",
              "label": "Country the commodity was sent from",
              "obligationRef": "consignment-origin"
            },
            {
              "fieldName": "local-reference-number",
              "fieldType": "text",
              "label": "Your reference (optional)",
              "obligationRef": "reference-number"
            }
          ]
        },
        {
          "id": "01-03",
          "screenName": "Reason for importing",
          "fields": [
            {
              "fieldName": "purpose",
              "fieldType": "radio",
              "label": "What is the purpose of this consignment?",
              "obligationRef": "import-purpose"
            },
            {
              "fieldName": "sub-purpose",
              "fieldType": "radio",
              "label": "Import or admission",
              "obligationRef": "import-purpose",
              "visibility": { "dependsOn": "purpose" }
            },
            {
              "fieldName": "exit-bcp",
              "fieldType": "select",
              "label": "Exit BCP",
              "obligationRef": "transit-routing",
              "visibility": { "dependsOn": "purpose" }
            },
            {
              "fieldName": "destination-country",
              "fieldType": "select",
              "label": "Destination third country",
              "obligationRef": "transit-routing",
              "visibility": { "dependsOn": "purpose" }
            },
            {
              "fieldName": "transit-countries",
              "fieldType": "select",
              "label": "Transit third countries",
              "obligationRef": "transit-routing",
              "visibility": { "dependsOn": "purpose" }
            },
            {
              "fieldName": "final-bip",
              "fieldType": "select",
              "label": "Final BIP",
              "obligationRef": "transhipment-routing",
              "visibility": { "dependsOn": "purpose" }
            },
            {
              "fieldName": "transhipment-country",
              "fieldType": "select",
              "label": "Country for transhipment",
              "obligationRef": "transhipment-routing",
              "visibility": { "dependsOn": "purpose" }
            }
          ]
        }
      ]
    },
    {
      "id": "02",
