        },
        {
          "id": "02-04",
          "screenName": "Commodity details",
          "repeats": "per commodity complement",
          "fields": [
            {
              "fieldName": "net-weight-{index}",
              "fieldType": "number",
              "label": "Net weight (kg)",
              "obligationRef": "commodity-complement-detail"
            },
            {
              "fieldName": "number-packages-{index}",
              "fieldType": "number",
              "label": "Number of packages",
              "obligationRef": "commodity-complement-detail"
            },
            {
              "fieldName": "type-package-{index}",
              "fieldType": "select",
              "label": "Type of package",
              "obligationRef": "commodity-complement-detail"
            },
            {
              "fieldName": "quantity-{index}",
              "fieldType": "number",
              "label": "Quantity",
              "obligationRef": "commodity-complement-detail"
            },
            {
              "fieldName": "quantity-type-{index}",
              "fieldType": "select",
              "label": "Quantity type",
              "obligationRef": "commodity-complement-detail"
            },
            {
              "fieldName": "commodity-group-{index}",
              "fieldType": "text",
              "label": "Commodity group",
              "obligationRef": "commodity-complement-detail"
            },
            {
              "fieldName": "controlled-atmosphere-{index}",
              "fieldType": "radio",
              "label": "Controlled atmosphere container?",
              "obligationRef": "commodity-complement-detail"
            }
          ]
        },
        {
          "id": "02-05",
          "screenName": "Finished or propagated",
          "fields": [
            {
              "fieldName": "finished-or-propagated",
              "fieldType": "radio",
              "label": "Are these plants finished or for propagation?",
              "obligationRef": "finished-or-propagated"
